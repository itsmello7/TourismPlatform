# Auto detect text files and normalize line endings to LF
* text=auto

# C# files
*.cs text eol=crlf
*.csproj text eol=crlf

# JSON files
*.json text eol=crlf

# Markdown files
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf
*.ps2 text eol=crlf

# Visual Studio files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.proj text eol=crlf
*.projitems text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
