using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using TourismPlatform.Models;

namespace TourismPlatform.Controllers
{
    public class BookingsController : Controller
    {
        private readonly ApplicationDbContext _context;

        public BookingsController(ApplicationDbContext context)
        {
            _context = context;
        }

        // GET: Bookings
        public async Task<IActionResult> Index()
        {
            var userId = HttpContext.Session.GetInt32("UserId");
            var role = HttpContext.Session.GetString("UserRole");

            if (userId == null)
            {
                return RedirectToAction("Login", "Account");
            }

            if (role == "Tourist")
            {
                var touristProfile = await _context.TouristProfiles.FirstOrDefaultAsync(t => t.UserId == userId);
                if (touristProfile == null)
                {
                    return RedirectToAction("Login", "Account");
                }

                var bookings = await _context.Bookings
                    .Where(b => b.TouristId == touristProfile.Id)
                    .Include(b => b.Tour)
                        .ThenInclude(t => t!.Agency)
                    .Include(b => b.Feedback)
                    .OrderByDescending(b => b.BookingDate)
                    .ToListAsync();

                return View("TouristBookings", bookings);
            }
            else if (role == "Agency")
            {
                var agencyProfile = await _context.AgencyProfiles.FirstOrDefaultAsync(a => a.UserId == userId);
                if (agencyProfile == null)
                {
                    return RedirectToAction("Login", "Account");
                }

                var bookings = await _context.Bookings
                    .Include(b => b.Tour)
                    .Include(b => b.Tourist)
                        .ThenInclude(t => t!.User)
                    .Where(b => b.Tour!.AgencyId == agencyProfile.Id)
                    .OrderByDescending(b => b.BookingDate)
                    .ToListAsync();

                return View("AgencyBookings", bookings);
            }

            return RedirectToAction("Login", "Account");
        }

        // GET: Bookings/Create/5 (tourId)
        public async Task<IActionResult> Create(int? id)
        {
            var userId = HttpContext.Session.GetInt32("UserId");
            var role = HttpContext.Session.GetString("UserRole");

            if (userId == null || role != "Tourist")
            {
                return RedirectToAction("Login", "Account");
            }

            if (id == null)
            {
                return NotFound();
            }

            var tour = await _context.Tours.Include(t => t.Agency).FirstOrDefaultAsync(t => t.Id == id);
            if (tour == null)
            {
                return NotFound();
            }

            ViewBag.Tour = tour;
            return View();
        }

        // POST: Bookings/Create
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Create(int tourId)
        {
            var userId = HttpContext.Session.GetInt32("UserId");
            var role = HttpContext.Session.GetString("UserRole");

            if (userId == null || role != "Tourist")
            {
                return RedirectToAction("Login", "Account");
            }

            var touristProfile = await _context.TouristProfiles.FirstOrDefaultAsync(t => t.UserId == userId);
            if (touristProfile == null)
            {
                return RedirectToAction("Login", "Account");
            }

            var tour = await _context.Tours.FindAsync(tourId);
            if (tour == null)
            {
                return NotFound();
            }

            // Check if already booked
            var existingBooking = await _context.Bookings
                .AnyAsync(b => b.TourId == tourId && b.TouristId == touristProfile.Id);

            if (existingBooking)
            {
                TempData["Error"] = "You have already booked this tour.";
                return RedirectToAction("Details", "Tours", new { id = tourId });
            }

            // Check group size limit
            var currentBookings = await _context.Bookings
                .CountAsync(b => b.TourId == tourId && b.Status != "Cancelled");

            if (currentBookings >= tour.MaxGroupSize)
            {
                TempData["Error"] = "This tour is fully booked.";
                return RedirectToAction("Details", "Tours", new { id = tourId });
            }

            var booking = new Booking
            {
                TourId = tourId,
                TouristId = touristProfile.Id,
                BookingDate = DateTime.Now,
                Status = "Pending",
                PaymentStatus = "Unpaid"
            };

            _context.Bookings.Add(booking);
            await _context.SaveChangesAsync();

            TempData["Success"] = "Tour booked successfully!";
            return RedirectToAction(nameof(Index));
        }

        // POST: Bookings/UpdateStatus/5
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> UpdateStatus(int id, string status, string paymentStatus)
        {
            var userId = HttpContext.Session.GetInt32("UserId");
            var role = HttpContext.Session.GetString("UserRole");

            if (userId == null || role != "Agency")
            {
                return RedirectToAction("Login", "Account");
            }

            var agencyProfile = await _context.AgencyProfiles.FirstOrDefaultAsync(a => a.UserId == userId);
            var booking = await _context.Bookings
                .Include(b => b.Tour)
                .FirstOrDefaultAsync(b => b.Id == id);

            if (booking == null || agencyProfile == null || booking.Tour!.AgencyId != agencyProfile.Id)
            {
                return NotFound();
            }

            booking.Status = status;
            booking.PaymentStatus = paymentStatus;
            await _context.SaveChangesAsync();

            return RedirectToAction(nameof(Index));
        }

        // GET: Bookings/Details/5
        public async Task<IActionResult> Details(int? id)
        {
            var userId = HttpContext.Session.GetInt32("UserId");

            if (userId == null || id == null)
            {
                return RedirectToAction("Login", "Account");
            }

            var booking = await _context.Bookings
                .Include(b => b.Tour)
                    .ThenInclude(t => t!.Agency)
                .Include(b => b.Tourist)
                    .ThenInclude(t => t!.User)
                .Include(b => b.Feedback)
                .FirstOrDefaultAsync(b => b.Id == id);

            if (booking == null)
            {
                return NotFound();
            }

            return View(booking);
        }
    }
}
