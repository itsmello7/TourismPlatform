@model TourismPlatform.Models.Tour
@{
    ViewData["Title"] = Model.Title;
    var bookingsCount = Model.Bookings?.Count ?? 0;
    var spotsLeft = Model.MaxGroupSize - bookingsCount;
    var feedbacks = Model.Bookings?.Where(b => b.Feedback != null).Select(b => b.Feedback).ToList();
    var avgRating = feedbacks?.Any() == true ? feedbacks.Average(f => f!.Rating) : 0;
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 400px; object-fit: cover;">
            }
            else
            {
                <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 300px;">
                    <span class="display-1">🏞️</span>
                </div>
            }
            <div class="card-body">
                <h2 class="card-title">@Model.Title</h2>
                <p class="text-muted">By <strong>@Model.Agency?.AgencyName</strong></p>
                
                <hr />
                
                <h5>Description</h5>
                <p>@(Model.Description ?? "No description available.")</p>
            </div>
        </div>
        
        <!-- Feedbacks Section -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">⭐ Reviews (@(feedbacks?.Count ?? 0))</h5>
            </div>
            <div class="card-body">
                @if (feedbacks?.Any() == true)
                {
                    @foreach (var feedback in feedbacks)
                    {
                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between">
                                <strong>@feedback!.Booking?.Tourist?.User?.FullName</strong>
                                <span>
                                    @for (int i = 0; i < feedback.Rating; i++)
                                    {
                                        <span>⭐</span>
                                    }
                                </span>
                            </div>
                            <p class="mb-0">@feedback.Comment</p>
                            <small class="text-muted">@feedback.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">No reviews yet.</p>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card sticky-top" style="top: 20px;">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Tour Details</h5>
            </div>
            <div class="card-body">
                <p><strong>💰 Price:</strong> $@Model.Price</p>
                <p><strong>📅 Duration:</strong> @Model.DurationDays days</p>
                <p><strong>🗓️ Start Date:</strong> @Model.StartDate.ToString("MMM dd, yyyy")</p>
                <p><strong>🗓️ End Date:</strong> @Model.EndDate.ToString("MMM dd, yyyy")</p>
                <p><strong>👥 Group Size:</strong> @Model.MaxGroupSize persons</p>
                <p><strong>🎫 Spots Left:</strong> 
                    @if (spotsLeft > 0)
                    {
                        <span class="text-success">@spotsLeft available</span>
                    }
                    else
                    {
                        <span class="text-danger">Fully Booked</span>
                    }
                </p>
                @if (avgRating > 0)
                {
                    <p><strong>⭐ Rating:</strong> @avgRating.ToString("0.0") / 5</p>
                }
                
                <hr />
                
                @if (Context.Session.GetString("UserRole") == "Tourist" && spotsLeft > 0)
                {
                    <a asp-controller="Bookings" asp-action="Create" asp-route-id="@Model.Id" class="btn btn-success w-100">
                        📝 Book Now
                    </a>
                }
                else if (Context.Session.GetInt32("UserId") == null)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                        Login to Book
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Tours</a>
</div>
