@{
    ViewData["Title"] = "Book Tour";
    var tour = ViewBag.Tour as TourismPlatform.Models.Tour;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">📝 Book Tour</h4>
            </div>
            <div class="card-body">
                @if (tour != null)
                {
                    <div class="mb-4">
                        <h5>@tour.Title</h5>
                        <p class="text-muted">By @tour.Agency?.AgencyName</p>
                        <hr />
                        <p><strong>Price:</strong> $@tour.Price</p>
                        <p><strong>Duration:</strong> @tour.DurationDays days</p>
                        <p><strong>Dates:</strong> @tour.StartDate.ToString("MMM dd, yyyy") - @tour.EndDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="tourId" value="@tour.Id" />
                        
                        <div class="alert alert-info">
                            <strong>Note:</strong> By clicking "Confirm Booking", you agree to book this tour. Payment will be processed separately.
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Confirm Booking</button>
                            <a asp-controller="Tours" asp-action="Details" asp-route-id="@tour.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
