                        </svg>
                    </div>
                    <h3>Global Destinations</h3>
                    <p>Access tours across multiple countries and regions. Find the perfect destination for your next journey.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm-5 3a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1zm3 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-1z"/>
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                        </svg>
                    </div>
                    <h3>Easy Booking</h3>
                    <p>Simple and secure booking process. Reserve your spot in minutes and manage bookings with ease.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z"/>
                        </svg>
                    </div>
                    <h3>Verified Reviews</h3>
                    <p>Read authentic feedback from real travelers. Make informed decisions based on genuine experiences.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Tours Section -->
<section class="tours-section">
    <div class="container">
        <h2 class="section-title">Featured Tours</h2>
        @if (tours != null && tours.Any())
        {
            <div class="row">
                @foreach (var tour in tours)
                {
                    <div class="col-md-4 mb-4">
                        <div class="tour-card">
                            @if (!string.IsNullOrEmpty(tour.ImageUrl))
                            {
                                <img src="@tour.ImageUrl" class="tour-card-image" alt="@tour.Title">
                            }
                            else
                            {
                                <div class="tour-card-image-placeholder">
                                    <span>No Image Available</span>
                                </div>
                            }
                            <div class="tour-card-body">
                                <h4 class="tour-card-title">@tour.Title</h4>
                                <p class="tour-card-agency">@tour.Agency?.AgencyName</p>
                                <div class="tour-card-details">
                                    <span class="tour-price">$@tour.Price</span>
                                    <span class="tour-duration">@tour.DurationDays Days</span>
                                </div>
                                <a asp-controller="Tours" asp-action="Details" asp-route-id="@tour.Id" class="btn-secondary-custom">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No tours available at the moment. Check back soon for exciting travel opportunities.</p>
            </div>
        }
    </div>
</section>

<!-- Group Details Section -->
<section class="group-section">
    <div class="container">
        <h2 class="section-title">Development Team</h2>
        <div class="table-responsive">
            <table class="group-table">
