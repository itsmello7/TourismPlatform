@using TourismPlatform.Models
@{
    ViewData["Title"] = "Home";
    var tours = ViewBag.PopularTours as List<Tour>;
    var isLoggedIn = Context.Session.GetInt32("UserId") != null;
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <h1>Discover Your Next Adventure</h1>
        <p class="hero-subtitle">Explore handpicked tours and create unforgettable travel memories with trusted local guides and agencies.</p>
        @if (!isLoggedIn)
        {
            <a asp-controller="Tours" asp-action="Index" class="btn-primary-custom">Browse Tours</a>
        }
    </div>
</section>

