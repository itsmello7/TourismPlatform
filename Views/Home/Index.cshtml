                </thead>
                <tbody>
                    <tr>
                        <td>20027199</td>
                        <td>Saugat Pathak</td>
                    </tr>
                    <tr>
                        <td>20024096</td>
                        <td>Hritik Subedi</td>
                    </tr>
                    <tr>
                        <td>20023178</td>
                        <td>Rupesh Ray</td>
                    </tr>
                    <tr>
                        <td>20021142</td>
                        <td>Muhammad Umair Alsam</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- User Type Section -->
<section class="user-type-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="user-type-card agency-card">
                    <h3>For Agencies & Tour Guides</h3>
                    <p>Create and manage tours, handle bookings, track payments, and grow your travel business with our comprehensive platform.</p>
                    <ul class="user-type-features">
                        <li>Create unlimited tour listings</li>
                        <li>Manage booking requests</li>
                        <li>View detailed reports</li>
                        <li>Receive customer feedback</li>
                    </ul>
                    <a asp-controller="Account" asp-action="Register" class="btn-outline-custom">Register as Agency</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="user-type-card tourist-card">
                    <h3>For Tourists</h3>
                    <p>Discover amazing destinations, book your dream tours, and share your travel experiences with our community.</p>
                    <ul class="user-type-features">
                        <li>Browse curated tours</li>
                        <li>Secure online booking</li>
                        <li>Track booking status</li>
                        <li>Leave reviews and ratings</li>
                    </ul>
                    <a asp-controller="Account" asp-action="Register" class="btn-outline-custom">Register as Tourist</a>
                </div>
            </div>
        </div>
    </div>
</section>
