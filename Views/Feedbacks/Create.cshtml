@model TourismPlatform.Models.Feedback
@{
    ViewData["Title"] = "Leave Feedback";
    var booking = ViewBag.Booking as TourismPlatform.Models.Booking;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">⭐ Leave Feedback</h4>
            </div>
            <div class="card-body">
                @if (booking != null)
                {
                    <div class="mb-4">
                        <h5>@booking.Tour?.Title</h5>
                        <p class="text-muted">Share your experience!</p>
                    </div>
                    
                    <form asp-action="Create" method="post">
                        <input type="hidden" name="BookingId" value="@booking.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">Rating (1-5 stars)</label>
                            <select asp-for="Rating" class="form-select">
                                <option value="">Select rating...</option>
                                <option value="5">⭐⭐⭐⭐⭐ Excellent (5)</option>
                                <option value="4">⭐⭐⭐⭐ Very Good (4)</option>
                                <option value="3">⭐⭐⭐ Good (3)</option>
                                <option value="2">⭐⭐ Fair (2)</option>
                                <option value="1">⭐ Poor (1)</option>
                            </select>
                            <span asp-validation-for="Rating" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Comment" class="form-label">Comment</label>
                            <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Tell us about your experience..."></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Submit Feedback</button>
                            <a asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
